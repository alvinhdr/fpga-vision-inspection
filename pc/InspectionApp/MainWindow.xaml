<Window x:Class="InspectionApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Inspection station - operator view" Height="720" Width="1100" Background="#111111">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DDDDDD"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox"><Setter Property="Margin" Value="4,0"/><Setter Property="Padding" Value="3"/></Style>
        <Style TargetType="Button"><Setter Property="Margin" Value="4,0"/><Setter Property="Padding" Value="12,4"/></Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="200"/><RowDefinition Height="*"/><RowDefinition Height="130"/>
        </Grid.RowDefinitions>

        <!-- row 0: source -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Replay file:"/>
            <TextBox Width="380" Text="{Binding ReplayPath, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Browse..." Click="Browse_Click"/>
            <TextBlock Text="speed x" Margin="8,0,0,0"/>
            <TextBox Width="45" Text="{Binding Speed}"/>
            <Button Content="Replay" Command="{Binding StartReplayCommand}"/>
            <TextBlock Text="Port:" Margin="16,0,0,0"/>
            <TextBox Width="60" Text="{Binding ComPort}"/>
            <Button Content="Live" Command="{Binding StartLiveCommand}"/>
            <Button Content="Stop" Command="{Binding StopCommand}"/>
        </StackPanel>

        <!-- row 1: tolerance + export -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Nominal length (mm):"/>
            <TextBox Width="55" Text="{Binding Nominal}"/>
            <TextBlock Text="+- tolerance:" Margin="8,0,0,0"/>
            <TextBox Width="55" Text="{Binding Tolerance}"/>
            <Button Content="Send to board" Command="{Binding ApplyToleranceCommand}"/>
            <Button Content="Export parts (CSV)..." Click="Export_Click" Margin="24,0,0,0"/>
            <TextBlock Text="{Binding Message}" Margin="16,0,0,0" Foreground="#9AA"/>
        </StackPanel>

        <!-- row 2: big verdict + numbers -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{Binding VerdictColor}" CornerRadius="8" Margin="0,0,12,0">
                <TextBlock Text="{Binding Verdict}" FontSize="64" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding FrameText}" FontFamily="Consolas" FontSize="16"/>
                <TextBlock Text="{Binding StatusText}" FontFamily="Consolas" FontSize="16"/>
                <TextBlock Text="{Binding LengthText}" FontFamily="Consolas" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="{Binding WidthText}" FontFamily="Consolas" FontSize="16"/>
                <TextBlock Text="{Binding AngleText}" FontFamily="Consolas" FontSize="16"/>
                <TextBlock Text="{Binding AreaText}" FontFamily="Consolas" FontSize="16"/>
                <TextBlock Text="{Binding PartsText}" FontSize="20" FontWeight="Bold" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding YieldText}" FontSize="20" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <!-- row 3: trend chart -->
        <scottplot:WpfPlot Grid.Row="3" x:Name="TrendPlot" Margin="0,8,0,8"/>

        <!-- row 4: FAIL log -->
        <DockPanel Grid.Row="4">
            <TextBlock DockPanel.Dock="Top" Text="FAIL events" FontWeight="Bold"/>
            <ListBox ItemsSource="{Binding FailLog}" Background="#1B1B1B" Foreground="#F0A0A0" FontFamily="Consolas"/>
        </DockPanel>
    </Grid>
</Window>
